NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB is the only database. For local dev without MongoDB installed: `npm run db:dev`
MONGODB_URI=mongodb://127.0.0.1:27017/partyPolice

# Super Admin (created by `npm run seed:admin`, or automatically on first login if no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
FILE_SIGNING_SECRET=

# SMTP. Use SMTP_HOST=console in development to print emails to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Party Police <party@example.com>"
# Optional: force TLS (defaults to true only for port 465)
# SMTP_SECURE=  (leave unset: port 465 uses TLS, 587 uses STARTTLS)

# Bearer secret for POST /api/cron/tick (optional external trigger)
CRON_SECRET=

# Private file storage (must be persistent, outside build dirs)
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# Background worker: run inside the Next.js server (true) or only via `npm run worker` (false)
RUN_WORKER_IN_APP=true
WORKER_POLL_INTERVAL_MS=15000
# Thank-you email delay after completion (default 5 minutes)
THANK_YOU_DELAY_MS=300000

# Timezone for "party day" and the daily 9 AM party emails (IANA name)
APP_TIMEZONE=Asia/Kolkata
